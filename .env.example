# Copy to .env.local (for Next.js) and also keep as .env (for the npm scripts).
# Never commit the real files - they are in .gitignore.

# PostgreSQL with pgvector (local, Neon, Supabase...). Add ?sslmode=require for cloud DBs.
DATABASE_URL=postgresql://agrishield_app:change-me@localhost:5432/agrishield

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agrishield

# Long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
